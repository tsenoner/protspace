{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    // Without it `composite` roots the output at this directory, so declarations land in
    // dist/src/ instead of where package.json's `types` points (dist/index.d.ts).
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "target": "ES2020"
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"],
  "references": [{ "path": "../utils" }]
}
